#!/bin/sh
# Pre-commit hook: runs lint-staged (ESLint + Prettier) and TypeScript check
# on staged files. Blocks commit if any check fails.

echo "🔍 Running pre-commit quality checks..."

# 1. Lint staged files
pnpm exec lint-staged || {
  echo "❌ lint-staged failed. Fix the issues above and try again."
  exit 1
}

# 2. TypeScript check (full project — catches cross-file type errors)
pnpm check || {
  echo "❌ TypeScript check failed. Fix type errors and try again."
  exit 1
}

# 3. Check for stub files being committed to main
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
  STAGED_STUBS=$(git diff --cached --name-only | xargs grep -l "^// Stub:" 2>/dev/null || true)
  if [ -n "$STAGED_STUBS" ]; then
    echo "⚠️  WARNING: Committing stub files to main:"
    echo "$STAGED_STUBS"
    echo "   Stubs should be replaced with real implementations before merging to main."
    echo "   Proceeding anyway — but please track these in the quality dashboard."
  fi
fi

echo "✅ Pre-commit checks passed."
