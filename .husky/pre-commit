#!/usr/bin/env sh
# ─── Pre-commit quality gate ─────────────────────────────────────────────────
# Runs on every commit. Fast path: lint-staged only lints changed files.
# Full gate: TypeScript check + full test suite.
# To bypass in an emergency: git commit --no-verify

echo "🔍 Running lint-staged on changed files..."
npx lint-staged

echo "🔷 TypeScript check..."
pnpm check

echo "🧪 Running test suite..."
pnpm test
